  {
    "id": "formosan-rock-macaque",
    "group": "mammals",
    "scientificName": "Macaca cyclopis",
    "name": {
      "en": "Formosan Rock Macaque",
      "zh": "臺灣獼猴"
    },
    "facts": [
      {
        "en": "It is the only monkey that lives wild in Taiwan — and it lives nowhere else.",
        "zh": "牠是臺灣唯一的野生猴子，而且只住在臺灣。"
      },
      {
        "en": "It lives in family groups called troops.",
        "zh": "牠們成群生活，叫做「猴群」。"
      },
      {
        "en": "It can stuff food into pouches in its cheeks to eat later.",
        "zh": "牠可以把食物塞進臉頰的頰囊，等一下再慢慢吃。"
      }
    ],
    "habitat": {
      "en": "Forests and rocky cliffs, from the lowlands up to high mountains.",
      "zh": "森林和岩壁，從低海拔到高山都有。"
    },
